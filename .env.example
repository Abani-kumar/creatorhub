# Demo controls (account switcher, reviewer simulation, failure injection, reset).
# Local: only the exact string "true" enables them (`npm run dev` sets this via .env.development).
# Vercel: demo is on automatically unless you set DEMO_MODE=false.
DEMO_MODE=true

# Where the lightweight JSON database lives. Use ":memory:" for no persistence.
# On Vercel this defaults to /tmp (the only writable path).
# CREATORHUB_DB_PATH=.data/db.json
